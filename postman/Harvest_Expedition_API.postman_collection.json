{
  "info": {
    "_postman_id": "8c1f4a2e-7b6d-4e91-9a30-harvestexpedition",
    "name": "Harvest Expedition API",
    "description": "Risk-based post-harvest distribution API.\n\nImport this file in Postman: File → Import → upload this JSON.\n\nBase URL defaults to http://localhost:8009. Change the `baseUrl` collection variable if the API is hosted elsewhere.\n\nSuggested order (each step stores an ID for the next):\n1. List commodities — saves `commodityId`\n2. List vehicles — saves `vehicleId`\n3. Create scenario — saves `scenarioId`\n4. Add harvest — saves `harvestId`\n5. Score risk, preview feasibility, then run optimization\n\nOptimization modes: `cost_priority`, `balanced`, `spoilage_priority` (collection variable `optimizationMode`).\nRunning optimization marks the scenario `completed`. Add harvests while the scenario is still `draft`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8009" },
    { "key": "scenarioId", "value": "" },
    { "key": "commodityId", "value": "" },
    { "key": "harvestId", "value": "" },
    { "key": "vehicleId", "value": "" },
    { "key": "optimizationMode", "value": "balanced" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Returns API status and the current risk formula version."
          }
        }
      ]
    },
    {
      "name": "Commodities",
      "item": [
        {
          "name": "List commodities",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (Array.isArray(body) && body.length > 0) {",
                  "    pm.collectionVariables.set('commodityId', body[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/commodities?active_only=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "commodities"],
              "query": [
                { "key": "active_only", "value": "true", "description": "Set false to include inactive commodities" }
              ]
            },
            "description": "List commodity classes (A most perishable through E least perishable). Saves the first id as `commodityId`."
          }
        },
        {
          "name": "Get commodity",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/commodities/{{commodityId}}",
            "description": "Fetch one commodity by id."
          }
        },
        {
          "name": "Create commodity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('commodityId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tomato\",\n  \"perishability_class\": \"A\",\n  \"shelf_life_hours\": 18,\n  \"default_price_idr_per_kg\": 15000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/commodities",
            "description": "`perishability_class` must be a single letter A–E. Saves the new id as `commodityId`."
          }
        },
        {
          "name": "Update commodity",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"default_price_idr_per_kg\": 16000,\n  \"active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/commodities/{{commodityId}}",
            "description": "Partial update. Send only the fields you want to change."
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "List vehicles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (Array.isArray(body) && body.length > 0) {",
                  "    pm.collectionVariables.set('vehicleId', body[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/vehicles?active_only=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "vehicles"],
              "query": [
                { "key": "active_only", "value": "true", "description": "Set false to include inactive vehicles" }
              ]
            },
            "description": "List vehicles with capacity, location, availability, and cost. Saves the first id as `vehicleId`."
          }
        },
        {
          "name": "Get vehicle",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}",
            "description": "Fetch one vehicle by id."
          }
        },
        {
          "name": "Create vehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('vehicleId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pickup Truck 500kg\",\n  \"capacity_kg\": 500,\n  \"current_location_lat\": -6.9175,\n  \"current_location_lng\": 107.6191,\n  \"available_from\": \"2026-10-01T00:00:00Z\",\n  \"available_until\": null,\n  \"cost_per_km_idr\": 5000\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/vehicles",
            "description": "Register a vehicle. `available_until` may be null when there is no end time. Saves the new id as `vehicleId`."
          }
        },
        {
          "name": "Update vehicle",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cost_per_km_idr\": 5500,\n  \"active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}",
            "description": "Partial update. Send only the fields you want to change."
          }
        }
      ]
    },
    {
      "name": "Scenarios",
      "item": [
        {
          "name": "Create scenario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('scenarioId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bandung Morning Harvest — Oct 1\",\n  \"optimization_mode\": \"{{optimizationMode}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/scenarios",
            "description": "Create a draft planning scenario. `optimization_mode` is `cost_priority`, `balanced`, or `spoilage_priority`. Saves `scenarioId`."
          }
        },
        {
          "name": "List scenarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/scenarios",
            "description": "List scenarios with harvest counts, newest first."
          }
        },
        {
          "name": "Get scenario",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/scenarios/{{scenarioId}}",
            "description": "Scenario details including nested harvests."
          }
        },
        {
          "name": "Update scenario",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bandung Morning Harvest — revised\",\n  \"optimization_mode\": \"spoilage_priority\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/scenarios/{{scenarioId}}",
            "description": "Partial update. Optional `status`: `draft`, `ready`, `optimizing`, `completed`, `failed`."
          }
        },
        {
          "name": "Delete scenario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/scenarios/{{scenarioId}}",
            "description": "Delete the scenario and its harvests. Returns 204 with no body."
          }
        }
      ]
    },
    {
      "name": "Harvests",
      "item": [
        {
          "name": "Add harvest",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('harvestId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"commodity_id\": \"{{commodityId}}\",\n  \"label\": \"A\",\n  \"location_lat\": -6.85,\n  \"location_lng\": 107.55,\n  \"volume_kg\": 300,\n  \"harvested_at\": \"2026-10-01T02:00:00Z\",\n  \"destination_lat\": -6.9175,\n  \"destination_lng\": 107.6191,\n  \"destination_name\": \"Pasar Induk Caringin\",\n  \"handling_factor\": 1.0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/scenarios/{{scenarioId}}/harvests",
            "description": "Add a harvest to a draft scenario. `handling_factor` must be >= 1.0. Requires `commodityId` from List or Create commodity. Saves `harvestId`."
          }
        },
        {
          "name": "List harvests",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/scenarios/{{scenarioId}}/harvests",
            "description": "List harvests in a scenario, ordered by label."
          }
        },
        {
          "name": "Update harvest",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"volume_kg\": 350,\n  \"handling_factor\": 1.2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/harvests/{{harvestId}}",
            "description": "Partial update of one harvest."
          }
        },
        {
          "name": "Delete harvest",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/harvests/{{harvestId}}",
            "description": "Remove a harvest. Returns 204 with no body."
          }
        }
      ]
    },
    {
      "name": "Risk",
      "item": [
        {
          "name": "Score persisted harvests",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"harvest_ids\": [\"{{harvestId}}\"],\n  \"estimated_transit_hours\": 4\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/risk/score",
            "description": "Score saved harvests. `estimated_transit_hours` applies to every id in `harvest_ids`. Optional `reference_time` overrides \"now\" for what-if analysis. Results are sorted by urgency, highest first."
          }
        },
        {
          "name": "Score inline harvests",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"harvests\": [\n    {\n      \"label\": \"A\",\n      \"commodity_id\": \"{{commodityId}}\",\n      \"harvested_at\": \"2026-10-01T02:00:00Z\",\n      \"estimated_transit_hours\": 6,\n      \"handling_factor\": 1.0\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/risk/score",
            "description": "Score harvests that are not saved yet. Provide `harvest_ids`, `harvests`, or both. At least one is required."
          }
        }
      ]
    },
    {
      "name": "Optimization",
      "item": [
        {
          "name": "Preview feasibility",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario_id\": \"{{scenarioId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/optimization/preview",
            "description": "Check which active vehicles can carry the scenario harvests, and whether they can be consolidated onto one vehicle. The scenario must already have harvests."
          }
        },
        {
          "name": "Run optimization",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario_id\": \"{{scenarioId}}\",\n  \"mode\": \"{{optimizationMode}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/optimization/run",
            "description": "Generate a baseline route and a spoilage-aware route, plus estimated food-loss and cost impact. Sets the scenario status to `completed`. Change `optimizationMode` to `cost_priority`, `balanced`, or `spoilage_priority`."
          }
        }
      ]
    }
  ]
}
